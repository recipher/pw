---
import Layout from "../layouts/layout.astro";
---

<Layout title="Peebles Wargaming | Play">
    <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h3
                class="text-3xl font-semibold font-serif tracking-tight text-gray-900 sm:text-3xl"
            >
                Play
            </h3>
            <p class="mt-8 text-md text-pretty text-gray-500 sm:text-lg/8">
                We meet every <b>Friday from 6:30pm</b> at the <a
                    class="underline"
                    href="https://peeblesscouts.org.uk/">Peebles Scout Hall</a
                > on <a
                    class="underline"
                    href="https://maps.app.goo.gl/WqGJ5CCdzAR6GowQ6"
                    target="_blank">Dean Park</a
                >.
            </p>
            <p class="mt-8 text-md text-pretty text-gray-500 sm:text-lg/8">
                Playing costs £6 a night, or if you'd like to <a
                    class="underline"
                    href="/join">join</a
                >, membership is £16 a month.
            </p>
        </div>
    </div>
</Layout>
