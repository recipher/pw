---
import Layout from "../layouts/layout.astro";
---

<Layout title="Peebles Wargaming">
    <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h2
                class="font-semibold text-5xl font-serif tracking-tight text-gray-900 sm:text-6xl"
            >
                <div class="flex">
                    <div class="w-1/4">
                        <img
                            alt="Peebles Wargaming"
                            src="/pwg-logo.png"
                            class="size-38 sm:size-48"
                        />
                    </div>
                    <div class="p-1 sm:p-9 w-3/4">
                        <div class="text-3xl">The</div>
                        <div class="text-5xl">Peebles Wargaming</div>
                        <div class="text-4xl">Council</div>
                    </div>
                </div>
            </h2>
            <p class="mt-8 text-lg text-pretty text-gray-500 sm:text-xl/8">
                We are a local wargames and role-playing collective, for the
                people of Peebles, Tweeddale and beyond.
            </p>
            <p class="mt-8 text-md text-pretty text-gray-500 sm:text-lg/8">
                Everyone is welcome, experienced gamers and beginners alike. Are
                you wargaming curious? Don't know where to start? Are you
                looking for more people to play with? Join us!
            </p>
            <p class="mt-8 text-md text-pretty text-gray-500 sm:text-lg/8">
                We meet every <b>Friday from 6:30pm</b> at the <a
                    class="underline"
                    href="https://peeblesscouts.org.uk/">Peebles Scout Hall</a
                > on <a
                    class="underline"
                    href="https://maps.app.goo.gl/WqGJ5CCdzAR6GowQ6"
                    target="_blank">Dean Park</a
                >.
            </p>
        </div>
    </div>
</Layout>
