---
import Layout from "../../layouts/layout.astro";
import Games from "../../components/games";
const games = [
    {
        name: "Dungeons and Dragons",
        image: "dnd.png",
        url: "https://www.dungeonsanddragons.com",
    },
    {
        name: "Dolmenwood",
        image: "dolmenwood.webp",
        url: "https://necroticgnome.com/pages/about-dolmenwood",
    },
    {
        name: "Old School Essentials",
        image: "ose.webp",
        url: "https://necroticgnome.com/pages/about-old-school-essentials",
    },
    {
        name: "Mothership",
        image: "mothership.png",
        url: "https://www.tuesdayknightgames.com/pages/mothership-rpg",
    },
];
const text = "We have a couple of bi-weekly RPG groups running.";
---

<Layout title="Peebles Wargaming | RPG">
    <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h3
                class="text-5xl font-semibold font-serif tracking-tight text-gray-900 sm:text-6xl"
            >
                Role Playing
            </h3>

            <Games games={games} text={text} />
        </div>
    </div>
</Layout>
