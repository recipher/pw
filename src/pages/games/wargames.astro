---
import Layout from "../../layouts/layout.astro";
import Games from "../../components/games";
const games = [
    {
        name: "Warhammer 40K",
        image: "wh40k.png",
        url: "https://warhammer40000.com/getting-started/",
    },
    {
        name: "Warhammer Age of Sigmar",
        image: "whaos.png",
        url: "https://ageofsigmar.com/starter-set-page/",
    },
    {
        name: "Warhammer The Old World",
        image: "whtow.png",
        url: "https://start-warhammer.com/theoldworld/",
    },
    {
        name: "Necromunda",
        image: "necromunda.png",
        url: "https://start-warhammer.com/necromunda/",
    },
    //{ name: "Star Wars Legion", image: "swl.webp" },
    {
        name: "Star Wars Shatterpoint",
        image: "swsp.webp",
        url: "https://www.atomicmassgames.com/shatterpoint/",
    },
    {
        name: "Marvel Crisis Protocol",
        image: "mcp.gif",
        url: "https://www.atomicmassgames.com/mcp/",
    },
    {
        name: "Infinity",
        image: "infinity.png",
        url: "https://infinityuniverse.com/en",
    },
    { name: "Warcrow", image: "warcrow.webp", url: "https://warcrow.com/en" },
    {
        name: "Relicblade",
        image: "relicblade.gif",
        url: "https://www.relicblade.com",
    },
    {
        name: "Bolt Action",
        image: "boltaction.png",
        url: "https://3rdedition.boltaction.com",
    },
    {
        name: "Blood Bowl",
        image: "bloodbowl.png",
        url: "https://start-warhammer.com/blood-bowl/",
    },
    {
        name: "Middle Earth Strategy Battle Game",
        image: "mesbg.png",
        url: "https://start-warhammer.com/middle-earth-strategy-battle/",
    },
];
const text =
    "We play a wide variety of wargames and we are always happy to learn and play something new.";
---

<Layout title="Peebles Wargaming | Wargames">
    <div class="bg-white px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <h3
                class="text-5xl font-semibold font-serif tracking-tight text-gray-900 sm:text-6xl"
            >
                Wargaming
            </h3>

            <Games games={games} text={text} />
        </div>
    </div>
</Layout>
